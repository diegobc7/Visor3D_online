{
 "name": "Visor 3D de planificación quirúrgica",
 "short_name": "Visor 3D",
 "start_url": "./",
 "scope": "./",
 "display": "standalone",
 "background_color": "#12151b",
 "theme_color": "#12151b",
 "icons": [
  {
   "src": "icon-192.png",
   "sizes": "192x192",
   "type": "image/png",
   "purpose": "any maskable"
  },
  {
   "src": "icon-512.png",
   "sizes": "512x512",
   "type": "image/png",
   "purpose": "any maskable"
  }
 ],
 "share_target": {
  "action": "./share-target",
  "method": "POST",
  "enctype": "multipart/form-data",
  "params": {
   "files": [
    {
     "name": "zip",
     "accept": [
      "application/zip",
      "application/x-zip-compressed",
      ".zip"
     ]
    }
   ]
  }
 }
}